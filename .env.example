# Variables de entorno de CodeLearn
# Copiar este archivo como .env y completar con los
# valores del proyecto de Supabase (Settings > API).
#
# IMPORTANTE: .env no se sube al repositorio.
# La clave publicable (anon) está pensada para el
# navegador, pero NO es una clave secreta.
# Nunca colocar aquí la service_role ni ninguna clave
# secreta: el frontend no debe contenerlas.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE
